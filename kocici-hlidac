#!/usr/bin/env python3
"""Kočičí hlídač: pozná kočku na klávesnici, zamkne ji a pustí spící kočku.

Čte klávesnice přímo z /dev/input (skupina `input`), žádné závislosti.

Detekce a nastavení jsou společné s Windows v kocici.py.

Zámek: klávesnice se grabne (EVIOCGRAB), takže do systému nejde nic.
Odemčení: napsat odemykací slovo (výchozí "mnau", v angličtině "meow");
na Linuxu se čte podle fyzické pozice kláves v rozložení US.

Použití:
  kocici-hlidac            démon
  kocici-hlidac --debug    jen loguje, co by detekoval, nezamyká
  kocici-hlidac --test     za 3 s zamkne (vyzkoušení)
"""
import fcntl
import os
import select
import signal
import struct
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import kocici  # noqa: E402

try:
    CFG = kocici.nastaveni()
except ValueError as e:
    sys.exit(str(e))
UNLOCK = CFG["unlock"]

EV_SYN, EV_KEY = 0, 1
EVENT = struct.Struct("llHHi")
KEY_MAX = 0x2FF
EVIOCGRAB = 0x40044590
EVIOCGKEY = (2 << 30) | (((KEY_MAX + 7) // 8) << 16) | (0x45 << 8) | 0x18

MODIFIERS = {29, 97, 42, 54, 56, 100, 125, 126, 58}  # ctrl, shift, alt, super, capslock
LETTERS = {c: k for c, k in zip("qwertyuiop", range(16, 26))}
LETTERS.update({c: k for c, k in zip("asdfghjkl", range(30, 39))})
LETTERS.update({c: k for c, k in zip("zxcvbnm", range(44, 51))})
UNLOCK_CODES = [LETTERS[c] for c in UNLOCK]

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
PROGRESS_FILE = os.path.join(RUNTIME, "kocici-hlidac.progress")
SCREENSAVER = os.path.join(HERE, "kocici-spanek")
OMARCHY = os.environ.get("OMARCHY_PATH", "/usr/share/omarchy")

DEBUG = "--debug" in sys.argv


def log(*a):
    print(time.strftime("%H:%M:%S"), *a, flush=True)


def find_keyboards():
    """Zařízení s handlerem kbd, která mají písmena A–Z."""
    found, block = [], {}
    with open("/proc/bus/input/devices") as f:
        text = f.read()
    for chunk in text.strip().split("\n\n"):
        block = {}
        for line in chunk.splitlines():
            if line.startswith("N: Name="):
                block["name"] = line[8:].strip('"')
            elif line.startswith("H: Handlers="):
                block["handlers"] = line[12:].split()
            elif line.startswith("B: KEY="):
                words = line[7:].split()[::-1]
                block["keys"] = sum(int(w, 16) << (64 * i) for i, w in enumerate(words))
        keys = block.get("keys", 0)
        if "kbd" not in block.get("handlers", []):
            continue
        if not all(keys >> k & 1 for k in (30, 44, 16, 50)):  # a z q m
            continue
        ev = next((h for h in block["handlers"] if h.startswith("event")), None)
        if ev:
            found.append(("/dev/input/" + ev, block.get("name", ev)))
    return found


class Hlidac:
    def __init__(self):
        self.devs = {}  # fd -> (path, name)
        self.det = kocici.Detektor(log if DEBUG else None)
        self.odem = kocici.Odemykani(UNLOCK_CODES)
        self.locked = False
        self.saver = None
        self.last_scan = 0.0

    # --- zařízení ---------------------------------------------------------
    def rescan(self):
        self.last_scan = time.monotonic()
        known = {p for p, _ in self.devs.values()}
        for path, name in find_keyboards():
            if path in known:
                continue
            try:
                fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
            except OSError as e:
                log("nejde otevřít", path, e)
                continue
            self.devs[fd] = (path, name)
            log("hlídám", path, name)
            if self.locked:
                self.grab(fd)

    def drop(self, fd):
        log("odpojeno", self.devs[fd][0])
        del self.devs[fd]
        self.det.reset()
        try:
            os.close(fd)
        except OSError:
            pass

    def grab(self, fd):
        # Než grabneme, pošleme systému uvolnění všech držených kláves, jinak by
        # v aplikaci zůstala viset autorepetice (grab už release nepustí dál).
        buf = bytearray((KEY_MAX + 7) // 8)
        try:
            fcntl.ioctl(fd, EVIOCGKEY, buf)
            held = [k for k in range(KEY_MAX + 1) if buf[k // 8] >> (k % 8) & 1]
            if held:
                data = b"".join(EVENT.pack(0, 0, EV_KEY, k, 0) for k in held)
                os.write(fd, data + EVENT.pack(0, 0, EV_SYN, 0, 0))
            fcntl.ioctl(fd, EVIOCGRAB, 1)
        except OSError as e:
            log("grab selhal", self.devs[fd][0], e)

    def ungrab(self, fd):
        try:
            fcntl.ioctl(fd, EVIOCGRAB, 0)
        except OSError:
            pass

    # --- zámek ------------------------------------------------------------
    def lock(self, reason):
        if DEBUG:
            log("KOČKA (debug, nezamykám):", reason)
            self.det.reset(time.monotonic())
            return
        log("KOČKA:", reason, "→ zamykám")
        self.locked = True
        self.odem.progress = 0
        self.write_progress()
        for fd in list(self.devs):
            self.grab(fd)
        self.det.reset()
        self.start_saver()

    def unlock(self):
        log("odemčeno")
        for fd in list(self.devs):
            self.ungrab(fd)
        self.locked = False
        self.det.reset(time.monotonic())
        self.stop_saver()
        try:
            os.unlink(PROGRESS_FILE)
        except OSError:
            pass

    def write_progress(self):
        try:
            with open(PROGRESS_FILE, "w") as f:
                f.write(f"{self.odem.progress} {UNLOCK}\n")
        except OSError:
            pass

    def start_saver(self):
        # Třída org.omarchy.screensaver: Omarchy okno roztáhne přes celou
        # obrazovku a svůj vlastní spořič přes něj nespustí.
        cmd = ["foot", "--app-id=org.omarchy.screensaver"]
        conf = f"{OMARCHY}/default/foot/screensaver.ini"
        if os.path.exists(conf):
            cmd.append(f"--config={conf}")
        cmd += ["-e", SCREENSAVER]
        try:
            self.saver = subprocess.Popen(cmd, start_new_session=True,
                                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            log("spořič nejde spustit", e)

    def stop_saver(self):
        if self.saver and self.saver.poll() is None:
            self.saver.terminate()
            try:
                self.saver.wait(2)
            except subprocess.TimeoutExpired:
                self.saver.kill()
        self.saver = None

    # --- události ---------------------------------------------------------
    def on_key(self, code, value, now):
        if code in MODIFIERS:
            return
        if self.locked:
            if value == 1:
                if self.odem.feed(code):
                    self.unlock()
                else:
                    self.write_progress()
            return
        if value == 0:
            self.det.release(code)
        elif value == 1:  # 2 = autorepetice
            reason = self.det.press(code, now)
            if reason:
                self.lock(reason)

    def check_hold(self, now):
        if not self.locked:
            reason = self.det.tick(now)
            if reason:
                self.lock(reason)

    def run(self):
        self.rescan()
        if "--test" in sys.argv:
            time.sleep(3)
            self.lock("test")
        while True:
            fds = list(self.devs)
            r, _, _ = select.select(fds, [], [], 0.25)
            now = time.monotonic()
            for fd in r:
                try:
                    data = os.read(fd, EVENT.size * 64)
                except BlockingIOError:
                    continue
                except OSError:
                    self.drop(fd)
                    continue
                for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                    _, _, typ, code, value = EVENT.unpack_from(data, i)
                    if typ == EV_KEY:
                        self.on_key(code, value, now)
            self.check_hold(now)
            if self.locked and self.saver and self.saver.poll() is not None:
                self.start_saver()  # někdo spořič zavřel, klávesnice je pořád zamčená
            if now - self.last_scan > 5:
                self.rescan()


def main():
    h = Hlidac()

    def stop(*_):
        if h.locked:
            h.unlock()
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        h.run()
    finally:
        if h.locked:
            h.unlock()


if __name__ == "__main__":
    main()
