#!/usr/bin/env python3
"""Spořič pro kocici-hlidac: kočka spí na klávesnici (terminál).

Scénu kreslí kocici.Scena, tady se jen převádí do ANSI. Okno zavírá hlídač
po odemčení; když sem přesto dorazí klávesa (hlídač neběží), spořič se sám ukončí.
"""
import os
import select
import signal
import sys
import termios
import time
import tty

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import kocici  # noqa: E402

PROGRESS_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "kocici-hlidac.progress")

RESET = "\x1b[0m"
ATTRS = {"bold": "\x1b[1m", "dim": "\x1b[2m"}


def ansi(style):
    if not style:
        return ""
    name, _, attr = style.partition("+")
    return ATTRS.get(attr, "") + f"\x1b[38;5;{kocici.COLORS[name][0]}m"


def read_progress(default_word):
    try:
        with open(PROGRESS_FILE) as f:
            n, word = f.read().split()
        return int(n), word
    except (OSError, ValueError):
        return 0, default_word


def render(grid, style):
    out = ["\x1b[H"]
    rows = len(grid)
    for y in range(rows):
        cur = None
        parts = []
        for ch, st in zip(grid[y], style[y]):
            if st != cur:
                parts.append(RESET + ansi(st))
                cur = st
            parts.append(ch)
        out.append("".join(parts) + RESET + ("\r\n" if y < rows - 1 else ""))
    return "".join(out)


def main():
    cfg = kocici.nastaveni()
    scena = kocici.Scena(cfg)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd) if os.isatty(fd) else None
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[2J")
    try:
        if old:
            tty.setraw(fd)
        start = time.monotonic()
        size = None
        while True:
            t = time.monotonic() - start
            cols, rows = os.get_terminal_size()
            if (cols, rows) != size:
                size = (cols, rows)
                sys.stdout.write("\x1b[2J")
            n, word = read_progress(cfg["unlock"])
            sys.stdout.write(render(*scena.frame(t, cols, rows, n, word)))
            sys.stdout.flush()
            # The scene changes slowly; redraw at 1 FPS to keep the saver cool.
            r, _, _ = select.select([fd], [], [], 1.0)
            if r:
                break  # klávesa prošla = hlídač neběží, nenechávej okno viset
    finally:
        if old:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[0m\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
